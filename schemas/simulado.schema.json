{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano de simulado",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration_minutes",
    "basis",
    "order",
    "matrix",
    "scoring",
    "annulled_ids"
  ],
  "properties": {
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_id",
        "locator"
      ],
      "properties": {
        "type": {
          "enum": [
            "autoral",
            "oficial"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective",
          "count"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "wrong",
        "blank",
        "annulled",
        "weights"
      ],
      "properties": {
        "correct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wrong": {
          "type": "number",
          "maximum": 0
        },
        "blank": {
          "type": "number",
          "maximum": 0
        },
        "annulled": {
          "enum": [
            "credit",
            "exclude"
          ]
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "annulled_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
