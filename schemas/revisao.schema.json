{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano de revisão ativa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "chapters"
  ],
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
