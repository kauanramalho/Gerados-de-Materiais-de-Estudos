{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fontes de um material",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "url",
      "locator",
      "checked_on",
      "rights"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "locator": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "checked_on": {
        "type": "string",
        "format": "date"
      },
      "rights": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
